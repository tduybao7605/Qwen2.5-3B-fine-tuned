# Copy sang local.properties rồi điền. local.properties nằm trong .gitignore —
# đừng commit file đó.
#
#   cp local.properties.example local.properties

# Android SDK — Android Studio thường tự sinh dòng này.
sdk.dir=/path/to/Android/Sdk

# URL của Cadebot API server. App gọi cả /stt lẫn /chat tới đây; speech-to-text
# chạy bằng PhoWhisper-large trên chính server này, không dùng dịch vụ ngoài.
#   http://10.0.2.2:8000        — Android emulator gọi về máy host
#   http://192.168.1.x:8000     — thiết bị thật, cùng mạng LAN với server
#   https://your-domain.example — server đã expose qua tunnel/reverse proxy
cadebot.api.url=http://10.0.2.2:8000
