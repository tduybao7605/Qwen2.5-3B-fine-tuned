# Copy sang .env rồi điền. .env nằm trong .gitignore — đừng bao giờ commit key thật.

# ── Dify (RAG) ────────────────────────────────────────────────────────
# Trên host:      http://localhost/v1
# Trong container: http://nginx/v1   (tên service trong network của Dify)
DIFY_BASE_URL=http://localhost/v1
# Knowledge → API Access → API Key. KHÔNG phải App API key — dùng nhầm nhận 401.
DIFY_DATASET_API_KEY=dataset-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_DATASET_ID=00000000-0000-0000-0000-000000000000

# ── Retrieval ─────────────────────────────────────────────────────────
# 0.51 hiệu chỉnh trên KB thật; xem docs/rag-setup.md.
SCORE_THRESHOLD=0.51
TOP_K=3
RETRIEVAL_TIMEOUT=15
SYNC_TIMEOUT=60

# ── Sinh văn ──────────────────────────────────────────────────────────
GEN_TEMPERATURE=0.2

# ── Model artifacts (tuỳ chọn — mặc định đã hợp lý trong cadebot/rag/config.py) ──
# CADEBOT_MODEL_DIR=/app/cadebot-lora
# CADEBOT_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
# CADEBOT_STT_MODEL=vinai/PhoWhisper-large

# ── Vận hành (tuỳ chọn) ───────────────────────────────────────────────
# Dùng cho `make health` để probe thêm endpoint công khai.
# PUBLIC_URL=https://your-tunnel.example.com
